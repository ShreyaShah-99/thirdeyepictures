# Dev only (loaded by `vite dev`, overrides .env).
# Use a RELATIVE base so the browser makes same-origin requests to the Vite
# dev server (http://localhost:5173/api/...). Vite's proxy (see vite.config.ts)
# forwards them server-side to the real backend, so the browser never issues a
# cross-origin CORS preflight — this avoids any proxy/VPN/AV that rewrites
# preflight responses on the network path.
VITE_API_URL=/api

# Cognito (same as .env)
VITE_COGNITO_USER_POOL_ID=ap-south-1_HJZSePsGU
VITE_COGNITO_CLIENT_ID=3phj9p3no8vt8nftoututdh9gl
VITE_AWS_REGION=ap-south-1
